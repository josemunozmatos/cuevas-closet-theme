      "default": "Discount code or gift card",
      "visible_if": "{{ section.settings.show_discount_input }}"
    },
    {
      "type": "text",
      "id": "discount_apply_label",
      "label": "Apply button text",
      "default": "Apply",
      "visible_if": "{{ section.settings.show_discount_input }}"
    },
    {
