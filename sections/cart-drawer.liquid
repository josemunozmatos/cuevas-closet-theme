    },
    {
      "type": "text",
      "id": "discount_error_generic",
      "label": "Error: could not apply",
      "default": "This code couldn’t be applied",
      "visible_if": "{{ section.settings.show_discount_input }}"
    },
    {
      "type": "header",
      "content": "Totals"
    },
    {
      "type": "checkbox",
      "id": "show_savings_line",
      "label": "Show total savings line",
      "default": true
    },
    {
      "type": "text",
      "id": "savings_label",
      "label": "Savings label",
      "default": "Savings",
      "info": "Shown as Savings: in the footer",
      "visible_if": "{{ section.settings.show_savings_line }}"
    },
    {
      "type": "select",
      "id": "savings_color",
      "label": "Savings line color",
      "options": [
        { "label": "Sale red", "value": "sale" },
        { "label": "Black (body text)", "value": "black" }
      ],
