        { "label": "Shipping, then savings", "value": "shipping_first" }
      ],
      "default": "savings_first"
    },
    {
      "type": "checkbox",
      "id": "show_shipping_line",
      "label": "Show shipping line when free shipping is met",
      "info": "Shows $6.00 struck through next to Free. Hidden until the $75 threshold is met.",
      "default": true
    },
    {
      "type": "text",
      "id": "shipping_label",
      "label": "Shipping label",
      "default": "Shipping",
      "visible_if": "{{ section.settings.show_shipping_line }}"
