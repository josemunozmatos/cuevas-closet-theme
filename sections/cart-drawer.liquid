        { "value": "return", "label": "Return (returns)" },
        { "value": "price_tag", "label": "Price tag" },
        { "value": "check_mark_in_circle", "label": "Check mark" },
        { "value": "heart", "label": "Heart" },
        { "value": "lock", "label": "Lock (security)" },
        { "value": "star", "label": "Star" },
        { "value": "gift", "label": "Gift" },
        { "value": "percent", "label": "Percent" },
        { "value": "shirt", "label": "Shirt" },
        { "value": "box", "label": "Box" },
        { "value": "chat_bubble", "label": "Chat bubble" },
        { "value": "credit_card", "label": "Credit card" },
        { "value": "map_pin", "label": "Map pin" },
        { "value": "award", "label": "Award" }
      ],
      "visible_if": "{{ section.settings.show_value_props }}"
    },
    {
      "type": "text",
      "id": "value_prop_1_text",
      "label": "Column 1 — text",
      "default": "free pickup disponible in Cupey Store",
      "visible_if": "{{ section.settings.show_value_props }}"
    },
    {
      "type": "select",
      "id": "value_prop_2_icon",
      "label": "Column 2 — icon",
      "default": "box",
      "options": [
        { "value": "none", "label": "No icon" },
        { "value": "truck", "label": "Truck (shipping)" },
        { "value": "return", "label": "Return (returns)" },
        { "value": "price_tag", "label": "Price tag" },
        { "value": "check_mark_in_circle", "label": "Check mark" },
        { "value": "heart", "label": "Heart" },
        { "value": "lock", "label": "Lock (security)" },
        { "value": "star", "label": "Star" },
        { "value": "gift", "label": "Gift" },
        { "value": "percent", "label": "Percent" },
        { "value": "shirt", "label": "Shirt" },
        { "value": "box", "label": "Box" },
        { "value": "chat_bubble", "label": "Chat bubble" },
        { "value": "credit_card", "label": "Credit card" },
        { "value": "map_pin", "label": "Map pin" },
        { "value": "award", "label": "Award" }
      ],
      "visible_if": "{{ section.settings.show_value_props and section.settings.value_props_columns >= 2 }}"
    },
    {
